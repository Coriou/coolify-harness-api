{
  "name": "coolify-harness",
  "version": "0.5.0",
  "description": "Agent control plane for Coolify: a safe CLI + typed library to deploy and wait, manage env vars (dry-run by default, values never printed), read status and logs, edit service composes, the proxy (Traefik) and databases — plus env catalogs generated from Zod schemas.",
  "keywords": [
    "coolify",
    "coolify-api",
    "self-hosted",
    "paas",
    "ai",
    "agents",
    "claude-code",
    "cursor",
    "deployment",
    "env",
    "environment-variables",
    "zod",
    "cli",
    "typescript",
    "devops"
  ],
  "license": "MIT",
  "author": "Benjamin Coriou",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Coriou/coolify-harness-api.git"
  },
  "homepage": "https://github.com/Coriou/coolify-harness-api#readme",
  "bugs": {
    "url": "https://github.com/Coriou/coolify-harness-api/issues"
  },
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": { "node": ">=24" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./client": { "types": "./dist/client/coolify.d.ts", "default": "./dist/client/coolify.js" },
    "./catalog": { "types": "./dist/catalog/generate.d.ts", "default": "./dist/catalog/generate.js" },
    "./config": { "types": "./dist/config/load.d.ts", "default": "./dist/config/load.js" },
    "./cli": { "types": "./dist/cli/main.d.ts", "default": "./dist/cli/main.js" },
    "./package.json": "./package.json"
  },
  "bin": { "coolify-harness": "./dist/cli/main.js" },
  "files": ["dist", "CHANGELOG.md"],
  "sideEffects": false,
  "scripts": {
    "dev": "tsc --watch",
    "build": "rm -rf dist && tsc -p tsconfig.json && chmod +x dist/cli/main.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "eslint . && tsc --noEmit && vitest run",
    "check:dist": "rm -rf dist && tsc -p tsconfig.json && chmod +x dist/cli/main.js && git diff --exit-code -- dist",
    "clean": "rm -rf dist node_modules/.cache"
  },
  "dependencies": { "zod": "^4.0.0" },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
