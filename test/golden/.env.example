# Comma-separated allowlist
# type: string | required: yes | services: api
CORS_ORIGINS=

# Toggle feature X
# type: boolean | required: no | services: api
FEATURE_X_ENABLED=false

# Ed25519 PEM
# type: string | required: no | services: api
JWT_PRIVATE_KEY=

# Pino log level
# type: string | required: no | services: api, web
LOG_LEVEL=info

# API base URL
# type: string | required: no | services: web
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# type: string | required: no | services: api
NO_DESCRIPTION_KEY=x

# Runtime mode
# type: enum | required: no | services: api
NODE_ENV=development

# Set if present
# type: string | required: no | services: api
OPTIONAL_FLAG=

# HTTP listen port
# type: number | required: no | services: api
PORT=3001
